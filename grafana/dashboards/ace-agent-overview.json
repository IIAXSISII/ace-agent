{
  "title": "ACE Agent Overview",
  "uid": "ace-agent-overview",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Request Volume",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}},
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "targets": [{"expr": "sum(orchestrator_requests_total)", "legendFormat": "Total Requests", "instant": true, "refId": "A", "datasource": {"type": "prometheus", "uid": "victoriametrics"}}]
    },
    {
      "id": 2,
      "title": "Avg Execution Time (s)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 2}, {"color": "red", "value": 5}]}},
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "targets": [{"expr": "rate(orchestrator_request_duration_seconds_sum[5m]) / rate(orchestrator_request_duration_seconds_count[5m])", "legendFormat": "Avg Duration", "instant": true, "refId": "A", "datasource": {"type": "prometheus", "uid": "victoriametrics"}}]
    },
    {
      "id": 3,
      "title": "Step Failures",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}},
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "targets": [{"expr": "sum(orchestrator_step_failures_total) or vector(0)", "legendFormat": "Step Failures", "instant": true, "refId": "A", "datasource": {"type": "prometheus", "uid": "victoriametrics"}}]
    },
    {
      "id": 7,
      "title": "Confidence Score (avg)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "green", "value": 0.8}]}},
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "targets": [{"expr": "rate(orchestrator_confidence_score_sum[5m]) / rate(orchestrator_confidence_score_count[5m])", "legendFormat": "Avg Confidence", "instant": true, "refId": "A", "datasource": {"type": "prometheus", "uid": "victoriametrics"}}]
    },
    {
      "id": 4,
      "title": "Request Rate (rpm)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "options": {"tooltip": {"mode": "single"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{"expr": "rate(orchestrator_requests_total[1m]) * 60", "legendFormat": "Requests/min", "refId": "A", "datasource": {"type": "prometheus", "uid": "victoriametrics"}}]
    },
    {
      "id": 5,
      "title": "Execution Duration (p99)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "victoriametrics"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "options": {"tooltip": {"mode": "single"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{"expr": "histogram_quantile(0.99, rate(orchestrator_request_duration_seconds_bucket[5m]))", "legendFormat": "p99 latency", "refId": "A", "datasource": {"type": "prometheus", "uid": "victoriametrics"}}]
    },
    {
      "id": 6,
      "title": "Traces — Open in Explore",
      "type": "text",
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 12},
      "options": {
        "mode": "markdown",
        "content": "## View Traces\n\n[🔍 Open ace-orchestrator traces in Explore](/explore?left={\"datasource\":\"victoriatraces\",\"queries\":[{\"queryType\":\"search\",\"service\":\"ace-orchestrator\",\"limit\":20,\"refId\":\"A\"}],\"range\":{\"from\":\"now-1h\",\"to\":\"now\"}})\n\nTraces are stored in **VictoriaTraces** and can be explored directly at [http://localhost:9428/select/vmui](http://localhost:9428/select/vmui)"
      }
    }
  ]
}
