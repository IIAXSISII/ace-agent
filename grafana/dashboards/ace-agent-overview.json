{
  "__inputs": [
    {
      "name": "DS_VICTORIAMETRICS",
      "label": "VictoriaMetrics",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_JAEGER",
      "label": "Jaeger",
      "description": "",
      "type": "datasource",
      "pluginId": "jaeger",
      "pluginName": "Jaeger"
    }
  ],
  "title": "ACE Agent Overview",
  "uid": "ace-agent-overview",
  "version": 1,
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Request Volume",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"},
      "targets": [{"expr": "sum(orchestrator_requests_total)", "legendFormat": "Total Requests"}]
    },
    {
      "id": 2,
      "title": "Avg Execution Time (s)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"},
      "targets": [{"expr": "rate(orchestrator_request_duration_seconds_sum[5m]) / rate(orchestrator_request_duration_seconds_count[5m])", "legendFormat": "Avg Duration"}]
    },
    {
      "id": 3,
      "title": "Step Failures",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"},
      "targets": [{"expr": "sum(orchestrator_step_failures_total)", "legendFormat": "Step Failures"}]
    },
    {
      "id": 4,
      "title": "Confidence Score Distribution",
      "type": "histogram",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "${DS_VICTORIAMETRICS}"},
      "targets": [{"expr": "orchestrator_confidence_score_bucket", "legendFormat": "{{le}}"}]
    }
  ]
}
