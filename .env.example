# =============================================================================
# AWS / Bedrock
# =============================================================================

# AWS credentials profile used for Bedrock API access (Claude inference)
AWS_PROFILE=<your-aws-profile>

# AWS region where Bedrock models are available
AWS_REGION=us-east-1

# =============================================================================
# Orchestrator
# =============================================================================

# AgentCore Memory store ID for cross-session memory (AgentCoreMemorySaver).
# Leave blank locally — MemorySaver (in-process) is used instead.
AGENTCORE_MEMORY_STORE_ID=

# AgentCore Gateway endpoint for MCP sub-agent invocations.
# Leave blank locally — sub-agents are invoked directly (in-process mock).
AGENTCORE_GATEWAY_ENDPOINT=

# Maximum token budget per request. Execution halts when this limit is reached.
TOKEN_BUDGET_LIMIT=50000

# Use in-memory fixtures instead of real DynamoDB / S3 for local development.
MOCK_STORAGE=true

# Load prompt templates from local YAML files instead of the
# prompt-template-registry DynamoDB table for local development.
MOCK_PROMPTS=true

# Bedrock Knowledge Base ID for RAG retrieval.
# Leave blank locally — a mock retriever returning fixture documents is used.
KNOWLEDGE_BASE_ID=

# Bedrock Guardrail ID for output scanning.
# Leave blank locally — a passthrough wrapper is used (no real guardrail applied).
GUARDRAIL_ID=

# =============================================================================
# Observability
# =============================================================================

# Controls which ADOT Collector pipeline is active.
# Use "local" for docker-compose stack; "production" for AgentCore Observability.
OTEL_STACK=local

# ADOT Collector gRPC endpoint that receives OTLP traces and metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Langfuse public key — local dev only (docker-compose Langfuse instance).
LANGFUSE_PUBLIC_KEY=<local-key>

# Langfuse secret key — local dev only (docker-compose Langfuse instance).
LANGFUSE_SECRET_KEY=<local-secret>

# Langfuse server base URL — local dev only.
LANGFUSE_BASE_URL=http://localhost:3000

# =============================================================================
# Chainlit UI
# =============================================================================

# Chainlit OAuth secret for AgentCore Identity integration.
# Leave blank locally — authentication is disabled when this is unset.
CHAINLIT_AUTH_SECRET=

# Orchestrator API URL used by the Chainlit UI to submit requests.
ORCHESTRATOR_URL=http://localhost:8080
