# syntax=docker/dockerfile:1
# Multi-stage ARM64 build for the Orchestrator — AgentCore Runtime deployment
# Uses uv for fast dependency installation.
# Exposes POST /invocations and GET /ping on port 8080.

# ── Builder stage ──────────────────────────────────────────────────────────────
FROM --platform=linux/arm64 ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

WORKDIR /app

# UV_COMPILE_BYTECODE: pre-compile .pyc files so the runtime stage starts faster.
# UV_LINK_MODE=copy: required when venv and cache are on different filesystem layers.
# UV_PROJECT_ENVIRONMENT: explicit venv path so the runtime stage knows where to copy from.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv

# Copy project definition and source so uv can install the project + dependencies.
COPY pyproject.toml .
COPY src/ ./src/

# Install all non-dev dependencies including the project itself into /app/.venv.
RUN uv sync --no-dev

# ── Runtime stage ──────────────────────────────────────────────────────────────
FROM --platform=linux/arm64 python:3.12-slim AS runtime

WORKDIR /app

# Copy the populated virtualenv from builder — no uv needed at runtime.
COPY --from=builder /app/.venv /app/.venv

# Copy application source.
COPY src/ ./src/

# Prepend venv bin to PATH so uvicorn resolves from the venv.
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app"

EXPOSE 8080

CMD ["uvicorn", "src.orchestrator.main:app", "--host", "0.0.0.0", "--port", "8080"]
